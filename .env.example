# Copie ce fichier en .env à la racine. Toutes les apps lisent la même source.

NODE_ENV=development

# --- Base de données (docker compose) ---
DATABASE_URL=postgresql://tando:tando@localhost:5432/tando?schema=public

# --- Redis (jobs BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3333
API_URL=http://localhost:3333
# Origines autorisées CORS, séparées par des virgules
WEB_ORIGIN=http://localhost:3000

# --- Sessions ---
# 32+ caractères aléatoires. openssl rand -hex 32
SESSION_SECRET=change-me-in-production-0000000000000000000000000000000000000000
# Nom du cookie de session (web)
SESSION_COOKIE=tando_session
# Durée de vie d'une session (secondes) — 30 jours
SESSION_TTL_SECONDS=2592000
# Durée de vie d'un lien magique (secondes) — 15 minutes
MAGIC_LINK_TTL_SECONDS=900

# --- Emails (mailpit en dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Tando <bonjour@tando.local>"

# --- Stockage objet (minio en dev, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=tando-documents
S3_ACCESS_KEY_ID=tando
S3_SECRET_ACCESS_KEY=tando-secret
S3_FORCE_PATH_STYLE=true

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Schéma de lien profond mobile (lien magique canal "mobile")
MOBILE_DEEP_LINK_SCHEME=tando

# --- Mobile (Expo) — voir apps/mobile/.env.example ---
