# Copie ce fichier en .env à la racine. Toutes les apps lisent la même source.

NODE_ENV=development

# --- Ports hôte Docker (optionnel) ---
# Surcharge les ports publiés par docker compose pour cohabiter avec d'autres
# stacks locales. Défauts entre parenthèses. Si tu en changes un, ajuste l'URL
# correspondante plus bas (DATABASE_URL / REDIS_URL / S3_ENDPOINT / SMTP_PORT).
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025

# --- Base de données (docker compose) ---
DATABASE_URL=postgresql://velekya:velekya@localhost:5432/velekya?schema=public

# --- Redis (jobs BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3333
API_URL=http://localhost:3333
# Origines autorisées CORS, séparées par des virgules
WEB_ORIGIN=http://localhost:3000
# Doc OpenAPI sur /api/docs. Vide = ouverte hors prod, fermée en prod.
# API_DOCS_ENABLED=false

# --- Observabilité ---
# Une ligne de log par requête HTTP (méthode, chemin, statut, durée).
REQUEST_LOG_ENABLED=true
# Au-delà (ms), la requête est journalisée en warn.
SLOW_REQUEST_MS=1000

# --- Limitation de débit ---
# Fenêtre (s) et nombre de requêtes autorisées par IP.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# true uniquement pour les tests e2e / le dev. Refusé si NODE_ENV=production.
RATE_LIMIT_DISABLED=false

# --- Sessions ---
# 32+ caractères aléatoires. openssl rand -hex 32
SESSION_SECRET=change-me-in-production-0000000000000000000000000000000000000000
# Nom du cookie de session (web)
SESSION_COOKIE=velekya_session
# Durée de vie d'une session (secondes) — 30 jours
SESSION_TTL_SECONDS=2592000
# Durée de vie d'un lien magique (secondes) — 15 minutes
MAGIC_LINK_TTL_SECONDS=900

# --- Emails (mailpit en dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Velekya <bonjour@velekya.local>"
# Lot 15 — boîte qui reçoit les questions transmises par les clients (défaut : MAIL_FROM).
# HELP_DESK_EMAIL=aide@velekya.local

# --- Stockage objet (minio en dev, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=velekya-documents
S3_ACCESS_KEY_ID=velekya
S3_SECRET_ACCESS_KEY=velekya-secret
S3_FORCE_PATH_STYLE=true

# --- Facturation (Lot 4) ---
VAT_RATE_PCT=20
# fake (dev/CI) ou stripe
PAYMENT_PROVIDER=fake
# Requis seulement si PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Identité vendeur figée dans chaque facture (mentions légales)
SELLER_NAME=Velekya
SELLER_LEGAL="[À COMPLÉTER — forme juridique, capital, SIREN, RCS, TVA]"
SELLER_ADDRESS="[À COMPLÉTER — adresse du siège social]"

# --- Abonnement / stores (Lot 9) ---
# out-of-app (défaut, abonnement géré sur le web) ou revenuecat (réservé)
BILLING_PROVIDER=out-of-app
BILLING_MANAGE_URL=http://localhost:3000/mon-equipe/compte
BILLING_MANAGE_HINT="Gérez votre contrat depuis votre espace, sur velekya.fr."

# --- Moteur « employé virtuel » (Lot 6) ---
# rules (défaut, à base de règles, sans fournisseur de modèle) ou n8n (Lot 13)
ASSISTANT_RUNTIME=rules
# Lot 16 — jours d'essai gratuit de l'offre prêt à l'emploi (0 = pas d'essai).
CATALOG_TRIAL_DAYS=14
# n8n : un flux par client, branché dans le back-office (Pilotage d'un employé).
# (pnpm n8n:up démarre n8n en local sur :5678 — voir docs/n8n/README.md)
# Si renseignée, l'adresse de chaque flux doit être sur cette instance.
# N8N_BASE_URL=http://localhost:5678
# Secret partagé dans les deux sens (en-tête X-Velekya-Token). Défaut hors prod : dev-n8n-token
# N8N_TOKEN=dev-n8n-token
# N8N_TIMEOUT_MS=15000

# --- Canaux de réception (Lot 12) ---
# Clé AES-256 (base64, 32 octets) : chiffre les adresses de réponse des clients
# et les jetons Meta. Obligatoire en production (openssl rand -base64 32).
# CHANNEL_SECRET_KEY=
# Rotation (Lot 19, voir DEPLOYMENT.md §10) : version de la clé courante et
# anciennes clés encore lisibles le temps du rechiffrement (« 1:base64,2:base64 »).
# CHANNEL_SECRET_KEY_VERSION=1
# CHANNEL_SECRET_KEY_PREVIOUS=
# fake : SMS / WhatsApp / Instagram simulés (les emails partent vers mailpit).
CHANNELS_DELIVERY=fake
# Domaine des adresses de réception (MX → Brevo en production).
INBOUND_EMAIL_DOMAIN=in.velekya.local
# Hors production, des secrets de dev s'appliquent si ces variables sont absentes
# (dev-brevo-inbound, dev-twilio-token, dev-meta-secret, dev-meta-verify).
# BREVO_INBOUND_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WEBHOOK_BASE_URL=https://api.velekya.fr
# META_APP_SECRET=
# META_VERIFY_TOKEN=

# --- Notifications push (Lot 8) ---
# false = ne pas contacter Expo (dev/CI). Les jobs sont créés puis ignorés.
PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Recommandé en production (Expo > Access Tokens)
# EXPO_ACCESS_TOKEN=

# --- Durées de conservation (Lot 18, §9.4) — en jours ; purge quotidienne à 03:00 ---
RETENTION_ENABLED=true
# RETENTION_MAGIC_LINK_DAYS=7
# RETENTION_SESSION_DAYS=30
# RETENTION_ASSESSMENT_DAYS=90
# RETENTION_PROSPECT_DAYS=1095
# RETENTION_WEBHOOK_DAYS=90
# RETENTION_PUSH_TOKEN_DAYS=30
# RETENTION_DELETED_ACCOUNT_DAYS=30
# Activité des comptes actifs (conversations, escalades traitées…). 0 = conservée.
# RETENTION_ACTIVITY_DAYS=730

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Schéma de lien profond mobile (lien magique canal "mobile")
MOBILE_DEEP_LINK_SCHEME=velekya

# --- Mobile (Expo) — voir apps/mobile/.env.example ---
