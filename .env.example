# Copie ce fichier en .env à la racine. Toutes les apps lisent la même source.

NODE_ENV=development

# --- Base de données (docker compose) ---
DATABASE_URL=postgresql://tando:tando@localhost:5432/tando?schema=public

# --- Redis (jobs BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3333
API_URL=http://localhost:3333
# Origines autorisées CORS, séparées par des virgules
WEB_ORIGIN=http://localhost:3000

# --- Sessions ---
# 32+ caractères aléatoires. openssl rand -hex 32
SESSION_SECRET=change-me-in-production-0000000000000000000000000000000000000000
# Nom du cookie de session (web)
SESSION_COOKIE=tando_session
# Durée de vie d'une session (secondes) — 30 jours
SESSION_TTL_SECONDS=2592000
# Durée de vie d'un lien magique (secondes) — 15 minutes
MAGIC_LINK_TTL_SECONDS=900

# --- Emails (mailpit en dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Tando <bonjour@tando.local>"

# --- Stockage objet (minio en dev, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=tando-documents
S3_ACCESS_KEY_ID=tando
S3_SECRET_ACCESS_KEY=tando-secret
S3_FORCE_PATH_STYLE=true

# --- Facturation (Lot 4) ---
VAT_RATE_PCT=20
# fake (dev/CI) ou stripe
PAYMENT_PROVIDER=fake
# Requis seulement si PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Identité vendeur figée dans chaque facture (mentions légales)
SELLER_NAME=Tando
SELLER_LEGAL="[À COMPLÉTER — forme juridique, capital, SIREN, RCS, TVA]"
SELLER_ADDRESS="[À COMPLÉTER — adresse du siège social]"

# --- Abonnement / stores (Lot 9) ---
# out-of-app (défaut, abonnement géré sur le web) ou revenuecat (réservé)
BILLING_PROVIDER=out-of-app
BILLING_MANAGE_URL=http://localhost:3000/mon-equipe/compte
BILLING_MANAGE_HINT="Gérez votre contrat depuis votre espace, sur tando.fr."

# --- Moteur « employé virtuel » (Lot 6) ---
# rules (défaut, à base de règles, sans fournisseur de modèle) ou fake (tests)
ASSISTANT_RUNTIME=rules
# Jeton partagé pour l'endpoint d'arrivée des demandes (/inbound)
INBOUND_SECRET=dev-inbound-secret

# --- Notifications push (Lot 8) ---
# false = ne pas contacter Expo (dev/CI). Les jobs sont créés puis ignorés.
PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Recommandé en production (Expo > Access Tokens)
# EXPO_ACCESS_TOKEN=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Schéma de lien profond mobile (lien magique canal "mobile")
MOBILE_DEEP_LINK_SCHEME=tando

# --- Mobile (Expo) — voir apps/mobile/.env.example ---
