{
  "name": "velekya",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:up": "docker compose up -d postgres redis minio mailpit",
    "db:down": "docker compose --profile n8n down",
    "n8n:up": "docker compose --profile n8n up -d n8n",
    "db:migrate": "pnpm --filter @velekya/api db:migrate",
    "db:seed": "pnpm --filter @velekya/api db:seed",
    "db:studio": "pnpm --filter @velekya/api db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate:deploy": "pnpm --filter @velekya/api db:migrate:deploy"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
