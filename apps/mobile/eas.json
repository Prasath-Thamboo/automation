{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:3333" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_API_URL": "https://api.tando.fr" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://api.tando.fr" }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "[À COMPLÉTER — Apple ID du compte développeur]",
        "ascAppId": "[À COMPLÉTER — App Store Connect App ID]",
        "appleTeamId": "[À COMPLÉTER — Apple Team ID]"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "appleId": "[À COMPLÉTER — Apple ID du compte développeur]",
        "ascAppId": "[À COMPLÉTER — App Store Connect App ID]",
        "appleTeamId": "[À COMPLÉTER — Apple Team ID]"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
