# apps/mobile — variables Expo (préfixe EXPO_PUBLIC_ pour être exposées au bundle).
#
# Simulateur iOS : http://localhost:3333 fonctionne.
# Appareil Android / iOS réel sur le même réseau : mettre l'IP de la machine,
#   ex. http://192.168.1.20:3333
# Build EAS preview/production : l'URL est fixée dans eas.json.
EXPO_PUBLIC_API_URL=http://localhost:3333
