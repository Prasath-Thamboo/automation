// Schéma Prisma — Lots 0 à 2.
// Lot 0 : identité, appartenance à une organisation, connexion par lien magique,
//         sessions, journal d'audit.
// Lot 2 : catalogue d'employés virtuels prêts à l'emploi — professions,
//         assistant_templates, assistant_template_versions (contenu versionné).
// Les autres tables métier (§9.2) — quotes, missions, invoices, … — viendront
// lot par lot.
//
// Règles transverses :
//  - soft delete via `deletedAt` partout SAUF sur les documents comptables (à venir, immuables) ;
//  - `organizationId` sur toute table métier, isolation appliquée par une garde centralisée
//    (voir src/prisma/tenant.ts), jamais laissée à chaque requête ;
//  - horodatages en UTC ;
//  - `AuditLog` sur toute action sensible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rôle d'un utilisateur au sein d'une organisation cliente.
/// `admin` est réservé au personnel Tando (accès back-office), il n'appartient à aucune organisation cliente.
enum MembershipRole {
  owner
  member
  admin
}

/// Canal d'origine d'une demande de lien magique — détermine la forme du lien envoyé.
enum AuthChannel {
  web
  mobile
}

/// Une organisation cliente (le compte d'une petite entreprise).
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  /// Identifiant lisible pour les URLs internes / le back-office.
  slug      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

/// Une personne physique. Peut appartenir à plusieurs organisations (multi-utilisateurs, §6).
model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  fullName  String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  memberships            Membership[]
  magicLinks             MagicLink[]
  sessions               Session[]
  auditLogs              AuditLog[]
  pushTokens             PushToken[]
  notificationPreference NotificationPreference?

  @@map("users")
}

/// Lien entre un utilisateur et une organisation, avec son rôle.
model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole @default(owner)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?      @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Jeton de connexion à usage unique, envoyé par email. Valable 15 minutes (§9.1).
/// Seul le hash du jeton est stocké — le jeton en clair ne vit que dans l'email.
model MagicLink {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  tokenHash  String      @unique
  channel    AuthChannel @default(web)
  expiresAt  DateTime    @db.Timestamptz(6)
  consumedAt DateTime?   @db.Timestamptz(6)
  /// Métadonnées de la demande, sans donnée personnelle en clair (§9.4).
  requestIp  String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("magic_links")
}

/// Session authentifiée. Web : cookie httpOnly. Mobile : jeton Bearer (expo-secure-store).
/// Seul le hash du jeton de session est stocké.
model Session {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  tokenHash  String      @unique
  channel    AuthChannel @default(web)
  userAgent  String?
  expiresAt  DateTime    @db.Timestamptz(6)
  revokedAt  DateTime?   @db.Timestamptz(6)
  lastSeenAt DateTime    @default(now()) @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Journal d'audit : toute action sensible (accès aux données client, connexion,
/// changement de prix, envoi de devis…). Immuable — jamais mis à jour ni supprimé.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  /// Nullable : certaines actions (ex. demande de lien magique) précèdent la résolution d'une organisation.
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  /// Verbe court, ex. "auth.magic_link.requested", "auth.session.created".
  action         String
  /// Cible optionnelle, ex. "user:<id>".
  target         String?
  /// Contexte non sensible (jamais d'email/téléphone en clair).
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Lot 2 — Catalogue d'employés virtuels prêts à l'emploi (§5)
// Piloté en base : on ajoute un métier sans redéploiement (back-office).
// Ces tables ne sont PAS rattachées à une organisation : le catalogue est public.
// ─────────────────────────────────────────────────────────────────────────────

enum TemplateStatus {
  draft
  published
  archived
}

/// Un métier proposé au catalogue (« l'assistant du dentiste », …).
model Profession {
  id              String    @id @default(uuid()) @db.Uuid
  /// Identifiant d'URL : /employes-virtuels/<slug>
  slug            String    @unique
  /// Nom affiché sur la carte et la fiche (« Cabinet dentaire »).
  name            String
  /// Secteur, pour le filtre du catalogue (« Santé », « Restauration », …).
  sector          String
  /// Phrase de bénéfice affichée sur la carte.
  benefit         String
  /// Besoins couverts, pour le filtre « par besoin ».
  needs           String[]
  monthlyPriceEur Int       @default(89)
  setupPriceEur   Int       @default(0)
  trialDays       Int       @default(14)
  /// Ordre d'affichage dans la grille.
  position        Int       @default(0)
  published       Boolean   @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  template AssistantTemplate?

  @@index([sector])
  @@map("professions")
}

/// Le modèle d'assistant d'un métier. Conteneur stable ; le contenu vit dans les versions.
model AssistantTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  professionId String   @unique @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  profession Profession                 @relation(fields: [professionId], references: [id], onDelete: Cascade)
  versions   AssistantTemplateVersion[]

  @@map("assistant_templates")
}

/// Une version du contenu d'une fiche métier (§5.1). Une seule version `published`
/// à la fois ; publier archive la précédente. `content` suit `templateContentSchema`
/// (@tando/types) : journée type, ce qu'il sait faire, démo pré-scriptée, curseurs
/// de gain, contrat, questions de personnalisation.
model AssistantTemplateVersion {
  id          String         @id @default(uuid()) @db.Uuid
  templateId  String         @db.Uuid
  version     Int
  status      TemplateStatus @default(draft)
  content     Json
  publishedAt DateTime?      @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  template AssistantTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("assistant_template_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Lot 3 — Employé virtuel sur mesure : questionnaire → fiche de poste → devis →
// acceptation → mission (§4). Facturation : Lot 4.
// ─────────────────────────────────────────────────────────────────────────────

enum QuoteStatus {
  brouillon
  en_relecture
  envoye
  vu
  accepte
  refuse
  expire
}

enum MissionStatus {
  a_preparer
  en_preparation
  en_service
  annulee
}

enum PricingRuleKind {
  socle
  module
  volume
  outil
}

/// Compteurs de numérotation séquentielle (DEV-AAAA-NNNN, FAC-AAAA-NNNN, …).
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

/// Le questionnaire de besoin (§4.1). Rempli anonymement ; repris via un lien
/// magique envoyé par email. `answers` en JSONB, clé par question.
model NeedsAssessment {
  id              String    @id @default(uuid()) @db.Uuid
  email           String
  resumeTokenHash String    @unique
  answers         Json      @default("{}")
  currentStep     Int       @default(0)
  completedAt     DateTime? @db.Timestamptz(6)
  /// Rattaché à une organisation une fois le devis accepté (compte créé).
  organizationId  String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  jobDescription JobDescription?
  quote          Quote?

  @@index([email])
  @@map("needs_assessments")
}

/// La fiche de poste en langage clair (§4.1 fin), dérivée des réponses puis
/// corrigeable par le client avant envoi. Versionnée.
model JobDescription {
  id                String   @id @default(uuid()) @db.Uuid
  needsAssessmentId String   @unique @db.Uuid
  version           Int      @default(1)
  content           Json
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  needsAssessment NeedsAssessment @relation(fields: [needsAssessmentId], references: [id], onDelete: Cascade)

  @@map("job_descriptions")
}

/// Barème de chiffrage, configurable en base (§4.2) — jamais en dur.
model PricingRule {
  id           String          @id @default(uuid()) @db.Uuid
  kind         PricingRuleKind
  key          String
  label        String
  setupCents   Int             @default(0)
  monthlyCents Int             @default(0)
  /// Modules : poids d'usage appliqué au mensuel. Volume : coefficient multiplicateur.
  factor       Float           @default(1)
  active       Boolean         @default(true)
  position     Int             @default(0)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)

  @@unique([kind, key])
  @@map("pricing_rules")
}

/// Un devis (§4.2). Numérotation DEV-AAAA-NNNN. Statuts :
/// brouillon → en_relecture → envoye → vu → accepte | refuse | expire.
model Quote {
  id                String      @id @default(uuid()) @db.Uuid
  needsAssessmentId String      @unique @db.Uuid
  organizationId    String?     @db.Uuid
  number            String      @unique
  status            QuoteStatus @default(brouillon)
  formula           String
  setupCents        Int         @default(0)
  monthlyCents      Int         @default(0)
  /// Ajustement manuel admin, 0.8 à 2.0. Commentaire obligatoire si ≠ 1.
  complexityFactor  Float       @default(1)
  complexityNote    String?
  engagementMonths  Int         @default(0)
  serviceDelayDays  Int         @default(14)
  /// Contenu figé affiché dans le devis (récap fiche de poste, bénéfices, hors périmètre).
  content           Json
  sentAt            DateTime?   @db.Timestamptz(6)
  viewedAt          DateTime?   @db.Timestamptz(6)
  decidedAt         DateTime?   @db.Timestamptz(6)
  expiresAt         DateTime?   @db.Timestamptz(6)
  reminderJ7At      DateTime?   @db.Timestamptz(6)
  reminderJ21At     DateTime?   @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?   @db.Timestamptz(6)

  needsAssessment NeedsAssessment  @relation(fields: [needsAssessmentId], references: [id], onDelete: Cascade)
  lineItems       QuoteLineItem[]
  acceptance      QuoteAcceptance?
  mission         Mission?

  @@index([status])
  @@map("quotes")
}

model QuoteLineItem {
  id           String @id @default(uuid()) @db.Uuid
  quoteId      String @db.Uuid
  kind         String
  label        String
  setupCents   Int    @default(0)
  monthlyCents Int    @default(0)
  position     Int    @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_items")
}

/// Preuve d'acceptation en ligne (§4.2) : horodatage, IP, hash du contenu accepté.
model QuoteAcceptance {
  id           String   @id @default(uuid()) @db.Uuid
  quoteId      String   @unique @db.Uuid
  acceptedName String
  cgvAccepted  Boolean
  ip           String?
  /// SHA-256 du contenu du devis au moment de l'acceptation.
  contentHash  String
  acceptedAt   DateTime @default(now()) @db.Timestamptz(6)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_acceptances")
}

/// Mission créée automatiquement à l'acceptation d'un devis (§4.3). Le pilotage
/// complet des missions arrive au Lot 10 ; ici on crée l'enregistrement.
model Mission {
  id             String        @id @default(uuid()) @db.Uuid
  quoteId        String        @unique @db.Uuid
  organizationId String        @db.Uuid
  status         MissionStatus @default(a_preparer)
  jobDescription Json
  answers        Json
  checklist      Json          @default("[]")
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("missions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Lot 4 — Paiement et facturation (§4.3, §9.4).
// Notre système est l'autorité sur la numérotation et le contenu des factures
// (séquentiel, inaltérable). Stripe (ou le fournisseur `fake` en dev) n'est que
// le rail de paiement.
// ─────────────────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  incomplete
  active
  past_due
  paused
  canceled
}

enum InvoiceKind {
  mise_en_service
  abonnement
}

enum InvoiceStatus {
  emise
  payee
  impayee
  annulee
}

enum PaymentStatus {
  en_attente
  reussi
  echoue
  rembourse
}

enum PaymentMethodType {
  carte
  prelevement
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  quoteId          String?            @unique @db.Uuid
  status           SubscriptionStatus @default(incomplete)
  formula          String
  currency         String             @default("eur")
  monthlyCents     Int
  setupCents       Int                @default(0)
  vatRatePct       Float              @default(20)
  /// Référence côté fournisseur (Stripe subscription id, ou "fake").
  providerRef      String?
  startedAt        DateTime?          @db.Timestamptz(6)
  canceledAt       DateTime?          @db.Timestamptz(6)
  currentPeriodEnd DateTime?          @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)

  invoices Invoice[]

  @@index([organizationId])
  @@index([status])
  @@map("subscriptions")
}

/// Facture. Inaltérable après émission (§9.4) : seuls `status` et les horodatages
/// de paiement/annulation évoluent, jamais le numéro, le contenu ou les montants.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  number         String        @unique
  organizationId String        @db.Uuid
  subscriptionId String?       @db.Uuid
  kind           InvoiceKind
  status         InvoiceStatus @default(emise)
  currency       String        @default("eur")
  vatRatePct     Float
  subtotalCents  Int
  vatCents       Int
  totalCents     Int
  issuedAt       DateTime      @default(now()) @db.Timestamptz(6)
  dueAt          DateTime?     @db.Timestamptz(6)
  periodStart    DateTime?     @db.Timestamptz(6)
  periodEnd      DateTime?     @db.Timestamptz(6)
  paidAt         DateTime?     @db.Timestamptz(6)
  voidedAt       DateTime?     @db.Timestamptz(6)
  /// Instantané figé : identité éditeur + client, lignes en clair, mentions légales.
  content        Json
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  subscription Subscription?     @relation(fields: [subscriptionId], references: [id])
  lineItems    InvoiceLineItem[]
  payments     Payment[]
  creditNotes  CreditNote[]

  @@index([organizationId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id         String @id @default(uuid()) @db.Uuid
  invoiceId  String @db.Uuid
  label      String
  quantity   Int    @default(1)
  unitCents  Int
  totalCents Int
  position   Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// Avoir. Une facture erronée n'est jamais corrigée : on émet un avoir (§4.3).
model CreditNote {
  id             String   @id @default(uuid()) @db.Uuid
  number         String   @unique
  invoiceId      String   @db.Uuid
  organizationId String   @db.Uuid
  reason         String
  currency       String   @default("eur")
  vatRatePct     Float
  subtotalCents  Int
  vatCents       Int
  totalCents     Int
  content        Json
  issuedAt       DateTime @default(now()) @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([organizationId])
  @@map("credit_notes")
}

model Payment {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  invoiceId      String?            @db.Uuid
  amountCents    Int
  currency       String             @default("eur")
  status         PaymentStatus      @default(en_attente)
  method         PaymentMethodType?
  provider       String
  providerRef    String?
  failureReason  String?
  paidAt         DateTime?          @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([organizationId])
  @@index([providerRef])
  @@map("payments")
}

/// Journal des évènements de webhook, pour l'idempotence (§10 Lot 4).
model WebhookEvent {
  id          String    @id
  provider    String
  type        String
  receivedAt  DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)

  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Lot 5 — Espace client et mise en service (§5.2, §6).
// L'assistant existe comme enregistrement ; le moteur (`AssistantRuntime`) qui
// produit conversations et escalades réelles arrive au Lot 6. En attendant, une
// activité de démonstration est générée à l'activation.
// ─────────────────────────────────────────────────────────────────────────────

enum AssistantState {
  en_formation
  au_travail
  en_pause
}

enum OnboardingStatus {
  en_cours
  termine
}

enum ConversationChannel {
  telephone
  whatsapp
  email
  instagram
  formulaire
  surplace
  autre
}

enum MessageAuthor {
  client
  assistant
  patron
}

enum EscalationStatus {
  ouverte
  repondue
}

model Assistant {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  missionId      String?          @unique @db.Uuid
  subscriptionId String?          @unique @db.Uuid
  /// Renseigné pour un assistant issu du catalogue (prêt à l'emploi).
  professionSlug String?
  /// Identifiant opaque pour l'arrivée des demandes (webhooks de canaux, Lot 7).
  publicId       String?          @unique
  name           String
  role           String
  state          AssistantState   @default(en_formation)
  /// Fiche de poste figée (issue de la mission ou du modèle de catalogue).
  jobDescription Json
  /// « Premier jour » (§5.2) : informations de l'établissement.
  establishment  Json             @default("{}")
  /// Réponses aux questions propres au métier (schéma du modèle).
  specifics      Json             @default("{}")
  /// Comment l'assistant joint le patron (email, téléphone, où arrivent les demandes).
  contactPrefs   Json             @default("{}")
  onboarding     OnboardingStatus @default(en_cours)
  onboardingStep Int              @default(0)
  startedAt      DateTime?        @db.Timestamptz(6)
  pausedAt       DateTime?        @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?        @db.Timestamptz(6)

  instructions  AssistantInstruction[]
  conversations Conversation[]
  escalations   Escalation[]
  appointments  Appointment[]

  @@index([organizationId])
  @@map("assistants")
}

// ─────────────────────────────────────────────────────────────────────────────
// Lot 6 — Runtime (§9.3). Capacité « prendre un rendez-vous ».
// ─────────────────────────────────────────────────────────────────────────────

enum AppointmentStatus {
  propose
  confirme
  annule
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  assistantId    String            @db.Uuid
  organizationId String            @db.Uuid
  conversationId String?           @db.Uuid
  customerLabel  String?
  /// Demande du client en clair (« jeudi après-midi si possible »).
  requestedText  String
  /// Créneau proposé / confirmé, si l'assistant a pu en fixer un.
  slot           DateTime?         @db.Timestamptz(6)
  status         AppointmentStatus @default(propose)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  assistant Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@index([assistantId, createdAt])
  @@map("appointments")
}

/// Consigne ajoutée par le client (§6 « Le former »). Versionnée : on garde l'historique.
model AssistantInstruction {
  id              String   @id @default(uuid()) @db.Uuid
  assistantId     String   @db.Uuid
  version         Int
  text            String
  createdByUserId String?  @db.Uuid
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  assistant Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@unique([assistantId, version])
  @@index([assistantId])
  @@map("assistant_instructions")
}

model Conversation {
  id             String              @id @default(uuid()) @db.Uuid
  assistantId    String              @db.Uuid
  organizationId String              @db.Uuid
  channel        ConversationChannel
  /// Étiquette non nominative (« Un client », ou le prénom si le client l'a donné).
  customerLabel  String?
  /// Fil de discussion côté canal / session d'essai. Jamais affiché.
  externalRef    String?
  /// Résumé en langage clair de ce que l'assistant a fait.
  summary        String?
  startedAt      DateTime            @default(now()) @db.Timestamptz(6)
  lastMessageAt  DateTime            @default(now()) @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)

  assistant Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([assistantId, lastMessageAt])
  @@index([assistantId, externalRef])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  author         MessageAuthor
  text           String
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

/// Ce que l'assistant n'a pas su traiter seul et remonte au patron (§6 « À valider »).
model Escalation {
  id               String           @id @default(uuid()) @db.Uuid
  assistantId      String           @db.Uuid
  organizationId   String           @db.Uuid
  conversationId   String?          @db.Uuid
  question         String
  context          String?
  status           EscalationStatus @default(ouverte)
  answer           String?
  answeredByUserId String?          @db.Uuid
  answeredAt       DateTime?        @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)

  assistant Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("escalations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Lot 8 — Application mobile, le cœur (§6bis). Notifications push + préférences.
// ─────────────────────────────────────────────────────────────────────────────

enum DevicePlatform {
  ios
  android
}

/// Jeton de notification push d'un appareil (Expo Push Token). Un utilisateur
/// peut avoir plusieurs appareils. On désactive (`disabledAt`) plutôt que
/// supprimer quand Expo signale l'appareil comme injoignable.
model PushToken {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  token          String         @unique
  platform       DevicePlatform
  deviceName     String?
  disabledAt     DateTime?      @db.Timestamptz(6)
  lastSeenAt     DateTime       @default(now()) @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("push_tokens")
}

/// Réglages de notification d'un utilisateur (§6bis : escalade urgente, résumé
/// quotidien optionnel, échec de paiement ; heures de silence ; jamais de push
/// marketing). Une ligne par utilisateur ; valeurs par défaut si absente.
model NotificationPreference {
  userId           String   @id @db.Uuid
  /// Escalade que l'assistant n'a pas su traiter → notification immédiate.
  escalations      Boolean  @default(true)
  /// Résumé de la veille, une fois par jour, à `dailySummaryHour` (heure locale).
  dailySummary     Boolean  @default(false)
  dailySummaryHour Int      @default(8)
  /// Échec d'un paiement d'abonnement.
  paymentFailure   Boolean  @default(true)
  /// Fenêtre de silence « HH:mm » (heure locale) — aucune notification non vitale.
  quietStart       String?
  quietEnd         String?
  /// Fuseau de l'utilisateur, pour l'heure du résumé et les heures de silence.
  timezone         String   @default("Europe/Paris")
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
